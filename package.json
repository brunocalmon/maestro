{
  "name": "@brunocalmon/maestro",
  "version": "2.1.30",
  "description": "Wrapper de linha de comando que orquestra subsistemas e agentes de codificação a partir de um contrato verificável de dependências.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunocalmon/maestro.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "maestro": "dist/cli.js",
    "maestro-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist",
    "resources"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@promovaweb/specsfy": "0.23.0",
    "context-mode": "1.0.169",
    "skills": "1.5.26",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "prebuild": "node scripts/check-version-checksum.mjs",
    "build": "tsc",
    "test:tdd": "vitest run",
    "verify": "node scripts/cycle.mjs"
  }
}
